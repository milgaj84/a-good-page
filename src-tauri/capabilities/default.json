{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the A Good Page main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-set-fullscreen",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
